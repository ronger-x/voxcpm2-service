# External Hugging Face cache. Point to an existing directory; models stay outside this repository.
# Windows example: D:/ai/VoxCPM2/hf-cache
# Linux example: /srv/voxcpm2/hf-cache
MODEL_CACHE_DIR=

# Set both secrets before starting Docker Compose.
VOXCPM_USER=admin
VOXCPM_PASSWORD=
VOXCPM_API_KEYS=

# Bind address and port of this project (use 7861 alongside an existing 7860 service).
VOXCPM_HOST=0.0.0.0
VOXCPM_PORT=7860

# Preset voice references (<name>.wav), selected by the request's voice field. Created if missing.
VOXCPM_VOICES_DIR=./voices

# 推理引擎：nano（Nano-vLLM，默认，开口更快）或 torch（上游 PyTorch 实现）
VOXCPM_ENGINE=nano
# nano 引擎按整卡显存的比例预留 KV cache；与 Ollama 等共用显卡时调小
VOXCPM_GPU_MEMORY_UTILIZATION=0.55
# 以下两项只对 torch 引擎生效
VOXCPM_CUDA_GRAPH=1
VOXCPM_COMPILE_FEATURES=1
# Set 1 to use only models already present in MODEL_CACHE_DIR.
HF_HUB_OFFLINE=0
